# ============================================
# Blend - Production Environment
# ============================================
# Copy this file to .env and fill in your values
# Production values are configured in the Vercel project settings
# ============================================

# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://username:password@cluster0.abc123.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# ---------- Google OAuth ----------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------- JWT ----------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here

# ---------- Domain Configuration ----------
# Public hostname
FRONTEND_DOMAIN=blend.tanmaytiwari.me

# Backend/API hostname (same Vercel deployment)
BACKEND_DOMAIN=blend.tanmaytiwari.me

# Full backend URL with the Vercel /api prefix; used for OAuth redirects
DEPLOYED_DOMAIN=https://blend.tanmaytiwari.me/api

# Full frontend URL — used by backend for CORS allow-origin
FRONTEND_URL=https://blend.tanmaytiwari.me

# ---------- Frontend Build ----------
# Same-origin API prefix routed by Vercel
VITE_API_URL=/api

# ---------- Optional ----------
ENABLE_DEBUG=false
ENABLE_FALLBACK=false
